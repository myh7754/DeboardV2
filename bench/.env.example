# 이 파일은 없어도 된다. 같은 값이 docker-compose.yml에 기본값으로 박혀 있다.
# 측정 파라미터를 바꾸고 싶을 때만 이 파일을 .env 로 복사해서 고친다.
#   copy .env.example .env
# 전부 벤치용 더미값이라 실제 비밀키가 아니다.

DB_USERNAME=bench
DB_PASSWORD=benchpw

# 부팅만 되면 되는 자리. 실제로 호출되지 않는다.
MAIL_USERNAME=bench@example.com
MAIL_PASSWORD=unused
GOOGLE_CLIENT_ID=unused
GOOGLE_CLIENT_SECRET=unused
KAKAO_CLIENT_ID=unused
KAKAO_CLIENT_SECRET=unused
NAVER_CLIENT_ID=unused
NAVER_CLIENT_SECRET=unused

# jjwt 0.12.6의 Keys.hmacShaKeyFor는 256bit(32바이트) 미만이면 WeakKeyException으로 죽는다.
# 아래 두 값은 반드시 32자 이상 유지할 것.
JWT_APP_KEY=bench-only-app-key-not-a-secret-0123456789
JWT_ORIGIN_KEY=bench-only-origin-key-not-a-secret-0123456789

# ── 측정 파라미터 (run.ps1 인자로도 덮어쓸 수 있음) ──
HEAP=1g
MYSQL_BUFFER_POOL=2G
HIKARI_POOL=10
